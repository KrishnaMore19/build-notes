NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/checkout
DB_POOL_MAX=10
LOG_LEVEL=info
# Required when NODE_ENV=production (min 16 chars). Replace with real auth for your app.
API_KEY=
RATE_LIMIT_PER_MINUTE=120
IDEMPOTENCY_TTL_HOURS=24
# Number of reverse proxies in front of the app (0 = none)
TRUST_PROXY=0
